# Application configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/finledger_db

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Gemini AI API Keys
GEMINI_KEY_1=your_gemini_api_key_1_here
GEMINI_KEY_2=your_gemini_api_key_2_here
GEMINI_KEY_3=your_gemini_api_key_3_here
